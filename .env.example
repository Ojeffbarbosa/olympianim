# Olympianim - Environment variables example
# Copy this file to ".env" and fill in your own credentials.
# Never commit the real ".env" file to version control.

# ---------------------------------------------------------------------------
# Language model providers (Bring Your Own Key)
# Only the keys you actually use are required.
# ---------------------------------------------------------------------------

# OpenAI - https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Google (Gemini) - https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=

# Anthropic (Claude) - https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=

# Optional timeout for each language-model request, in seconds.
# The default is 600 (10 minutes); accepted values are bounded to 60..3600.
OLYMPIANIM_LLM_TIMEOUT_SECONDS=600

# ---------------------------------------------------------------------------
# Voice (Text-to-Speech) providers
# Reuse the same key when the TTS service is offered by the LLM provider.
# ---------------------------------------------------------------------------

# OpenAI TTS reuses OPENAI_API_KEY.
# OpenAI voices: alloy, echo, fable, onyx, nova, shimmer, coral, sage, ash.
OPENAI_TTS_VOICE=alloy
OPENAI_TTS_MODEL=gpt-4o-mini-tts

# Google TTS (Gemini speech generation) reuses GOOGLE_API_KEY.
GOOGLE_TTS_VOICE=

# ---------------------------------------------------------------------------
# Optional: LangSmith tracing (observability for the LangGraph workflow)
# ---------------------------------------------------------------------------
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
